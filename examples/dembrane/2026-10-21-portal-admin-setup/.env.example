# A Google Cloud project with Vertex AI enabled, and credentials for it:
# either the JSON key of a service account with roles/aiplatform.user, which
# `pnpm google-key <key.json>` fills in, or an OAuth token, which
# `pnpm google-token` fills in and which lasts about an hour. The key wins if
# both are set.
GOOGLE_CLOUD_PROJECT=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_ACCESS_TOKEN=

# Optional. When set, the app asks for this password (any username) before
# letting anyone in. Leave it empty to keep local dev open.
BASIC_AUTH_PASSWORD=

TYPESAFE_API_KEY=
