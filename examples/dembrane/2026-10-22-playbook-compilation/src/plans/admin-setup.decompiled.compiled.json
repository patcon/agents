{
  "$schema": "../plan.schema.json",
  "schemaVersion": 1,
  "source": {
    "playbook": "admin-setup.decompiled",
    "version": "739f5be6"
  },
  "items": [
    {
      "id": "consent",
      "order": "a0",
      "locked": true,
      "kind": "consent"
    },
    {
      "id": "sec_basics",
      "order": "a1",
      "kind": "section",
      "payload": {
        "title": "Basics"
      }
    },
    {
      "id": "language",
      "order": "a0",
      "parentId": "sec_basics",
      "kind": "prompt",
      "payload": {
        "key": "language",
        "question": {
          "type": "radio",
          "prompt": "Which language will participants speak? Pick one: English, Dutch, German, French, Spanish, Italian, Ukrainian, Czech (options in two columns)",
          "options": [
            "English",
            "Dutch",
            "German",
            "French",
            "Spanish",
            "Italian",
            "Ukrainian",
            "Czech"
          ],
          "required": true
        },
        "card": {
          "root": "root",
          "elements": {
            "root": {
              "type": "RadioGroup",
              "props": {
                "options": [
                  "English",
                  "Dutch",
                  "German",
                  "French",
                  "Spanish",
                  "Italian",
                  "Ukrainian",
                  "Czech"
                ],
                "columns": 2,
                "value": {
                  "$bindState": "/value"
                }
              },
              "children": []
            }
          }
        }
      }
    },
    {
      "id": "default_conversation_ask_for_participant_details",
      "order": "a1",
      "parentId": "sec_basics",
      "kind": "prompt",
      "payload": {
        "key": "default_conversation_ask_for_participant_details",
        "question": {
          "type": "checkbox",
          "prompt": "What must be provided before each portal conversation? Pick any: A name, An email (optional)",
          "options": [
            "A name",
            "An email"
          ],
          "required": false
        }
      }
    },
    {
      "id": "is_project_notification_subscription_allowed",
      "order": "a2",
      "parentId": "sec_basics",
      "kind": "prompt",
      "payload": {
        "key": "is_project_notification_subscription_allowed",
        "question": {
          "type": "radio",
          "prompt": "Can participants ask to be emailed when the report is ready? Pick one: Yes, No (optional, only if \"An email\" is selected)",
          "options": [
            "Yes",
            "No"
          ],
          "required": false
        }
      }
    },
    {
      "id": "default_conversation_tutorial_slug",
      "order": "a3",
      "parentId": "sec_basics",
      "kind": "prompt",
      "payload": {
        "key": "default_conversation_tutorial_slug",
        "question": {
          "type": "radio",
          "prompt": "Which tutorial should participants see first? Pick one: None, Basic, Advanced",
          "options": [
            "None",
            "Basic",
            "Advanced"
          ],
          "required": true
        }
      }
    },
    {
      "id": "tags",
      "order": "a4",
      "parentId": "sec_basics",
      "kind": "prompt",
      "payload": {
        "key": "tags",
        "question": {
          "type": "text",
          "prompt": "Which tags can participants pick from? Separate them with commas. (optional)",
          "required": false
        }
      }
    },
    {
      "id": "sec_features",
      "order": "a2",
      "kind": "section",
      "payload": {
        "title": "Participant features"
      }
    },
    {
      "id": "is_get_reply_enabled",
      "order": "a0",
      "parentId": "sec_features",
      "kind": "prompt",
      "payload": {
        "key": "is_get_reply_enabled",
        "question": {
          "type": "radio",
          "prompt": "Should participants be able to use Explore? Pick one: Yes, No",
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        }
      }
    },
    {
      "id": "get_reply_mode",
      "order": "a1",
      "parentId": "sec_features",
      "kind": "prompt",
      "payload": {
        "key": "get_reply_mode",
        "question": {
          "type": "radio",
          "prompt": "Which Explore mode? Pick one: Summarize, Brainstorm, Custom (only if Explore is enabled)",
          "options": [
            "Summarize",
            "Brainstorm",
            "Custom"
          ],
          "required": true
        }
      }
    },
    {
      "id": "get_reply_prompt",
      "order": "a2",
      "parentId": "sec_features",
      "kind": "prompt",
      "payload": {
        "key": "get_reply_prompt",
        "question": {
          "type": "text",
          "prompt": "What should Explore's custom reply prompt say? (only if Explore mode is Custom)",
          "required": true
        }
      }
    },
    {
      "id": "is_verify_enabled",
      "order": "a3",
      "parentId": "sec_features",
      "kind": "prompt",
      "payload": {
        "key": "is_verify_enabled",
        "question": {
          "type": "radio",
          "prompt": "Should participants be able to use Verify? Pick one: Yes, No",
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        }
      }
    },
    {
      "id": "verification_topics",
      "order": "a4",
      "parentId": "sec_features",
      "kind": "prompt",
      "payload": {
        "key": "verification_topics",
        "question": {
          "type": "checkbox",
          "prompt": "Which topics should Verify check? Pick at least one. Pick any: Actions, Agreements, Disagreements, Gems, Moments, Truths (only if Verify is enabled)",
          "options": [
            "Actions",
            "Agreements",
            "Disagreements",
            "Gems",
            "Moments",
            "Truths"
          ],
          "required": true
        }
      }
    },
    {
      "id": "is_verify_on_finish_enabled",
      "order": "a5",
      "parentId": "sec_features",
      "kind": "prompt",
      "payload": {
        "key": "is_verify_on_finish_enabled",
        "question": {
          "type": "radio",
          "prompt": "Remind participants to verify when they finish? Pick one: Yes, No (optional, only if Verify is enabled)",
          "options": [
            "Yes",
            "No"
          ],
          "required": false
        }
      }
    },
    {
      "id": "sec_content",
      "order": "a3",
      "kind": "section",
      "payload": {
        "title": "Portal content"
      }
    },
    {
      "id": "default_conversation_title",
      "order": "a0",
      "parentId": "sec_content",
      "kind": "prompt",
      "payload": {
        "key": "default_conversation_title",
        "question": {
          "type": "text",
          "prompt": "What's the portal page's title?",
          "required": true
        }
      }
    },
    {
      "id": "default_conversation_description",
      "order": "a1",
      "parentId": "sec_content",
      "kind": "prompt",
      "payload": {
        "key": "default_conversation_description",
        "question": {
          "type": "text",
          "prompt": "What should the portal page say? (optional)",
          "required": false
        }
      }
    },
    {
      "id": "default_conversation_finish_text",
      "order": "a2",
      "parentId": "sec_content",
      "kind": "prompt",
      "payload": {
        "key": "default_conversation_finish_text",
        "question": {
          "type": "text",
          "prompt": "What should participants see when they're done? (optional)",
          "required": false
        }
      }
    },
    {
      "id": "sec_advanced",
      "order": "a4",
      "kind": "section",
      "payload": {
        "title": "Advanced"
      }
    },
    {
      "id": "default_conversation_transcript_prompt",
      "order": "a0",
      "parentId": "sec_advanced",
      "kind": "prompt",
      "payload": {
        "key": "default_conversation_transcript_prompt",
        "question": {
          "type": "text",
          "prompt": "Any key terms the transcriber should know? Separate them with commas. (optional)",
          "required": false
        }
      }
    },
    {
      "id": "anonymize_transcripts",
      "order": "a1",
      "parentId": "sec_advanced",
      "kind": "prompt",
      "payload": {
        "key": "anonymize_transcripts",
        "question": {
          "type": "radio",
          "prompt": "Anonymize transcripts? Pick one: Yes, No",
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        }
      }
    },
    {
      "id": "enable_ai_title_and_tags",
      "order": "a2",
      "parentId": "sec_advanced",
      "kind": "prompt",
      "payload": {
        "key": "enable_ai_title_and_tags",
        "question": {
          "type": "radio",
          "prompt": "Generate conversation titles and tags automatically? Pick one: Yes, No",
          "options": [
            "Yes",
            "No"
          ],
          "required": true
        }
      }
    },
    {
      "id": "conversation_title_prompt",
      "order": "a3",
      "parentId": "sec_advanced",
      "kind": "prompt",
      "payload": {
        "key": "conversation_title_prompt",
        "question": {
          "type": "text",
          "prompt": "How should titles be written? (optional custom prompt) (optional, only if automatic title and tag generation is enabled)",
          "required": false
        }
      }
    }
  ],
  "triggers": [
    {
      "id": "trig_start_consent",
      "when": {
        "kind": "start"
      },
      "cue": "consent"
    },
    {
      "id": "trig_consented_basics",
      "when": {
        "kind": "consented"
      },
      "cue": "sec_basics"
    },
    {
      "id": "trig_consented_features",
      "when": {
        "kind": "consented"
      },
      "cue": "sec_features"
    },
    {
      "id": "trig_consented_content",
      "when": {
        "kind": "consented"
      },
      "cue": "sec_content"
    },
    {
      "id": "trig_consented_advanced",
      "when": {
        "kind": "consented"
      },
      "cue": "sec_advanced"
    },
    {
      "id": "trig_notification_subscription",
      "when": {
        "kind": "includes",
        "key": "default_conversation_ask_for_participant_details",
        "option": "An email"
      },
      "cue": "is_project_notification_subscription_allowed"
    },
    {
      "id": "trig_get_reply_mode",
      "when": {
        "kind": "answer",
        "key": "is_get_reply_enabled",
        "equals": "Yes"
      },
      "cue": "get_reply_mode"
    },
    {
      "id": "trig_get_reply_prompt",
      "when": {
        "kind": "answer",
        "key": "get_reply_mode",
        "equals": "Custom"
      },
      "cue": "get_reply_prompt"
    },
    {
      "id": "trig_verification_topics",
      "when": {
        "kind": "answer",
        "key": "is_verify_enabled",
        "equals": "Yes"
      },
      "cue": "verification_topics"
    },
    {
      "id": "trig_is_verify_on_finish_enabled",
      "when": {
        "kind": "answer",
        "key": "is_verify_enabled",
        "equals": "Yes"
      },
      "cue": "is_verify_on_finish_enabled"
    },
    {
      "id": "trig_conversation_title_prompt",
      "when": {
        "kind": "answer",
        "key": "enable_ai_title_and_tags",
        "equals": "Yes"
      },
      "cue": "conversation_title_prompt"
    }
  ]
}
