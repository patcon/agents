# A Google Cloud project with Vertex AI enabled, and credentials for it:
# either the JSON key of a service account with roles/aiplatform.user, which
# `pnpm google-key <key.json>` fills in, or an OAuth token, which
# `pnpm google-token` fills in and which lasts about an hour. The key wins if
# both are set.
GOOGLE_CLOUD_PROJECT=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_ACCESS_TOKEN=

# Optional. When set, the app asks for this password (any username) before
# letting anyone in. Leave it empty to keep local dev open.
BASIC_AUTH_PASSWORD=

# Optional. A TypeSafe key (console.typesafe.ai) turns on Jev, which shades
# each option of a card by how likely it is the speaker chose it, and fills
# in the likely ones. JEV_ENABLED=false turns it off with the key still set.
TYPESAFE_API_KEY=
JEV_ENABLED=

# Optional. Drafting has AGENT_MODEL rewrite a text question's answer from
# what was said, after each utterance. DRAFT_ENABLED=false turns it off,
# leaving the words as said.
DRAFT_ENABLED=
