{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "voice-questionnaire-example",
  // Transcription and the agent's question both come from Gemini on Vertex AI.
  // In local dev the secrets come from .env (see .env.example);
  // `pnpm google-token` refreshes the token, which lasts an hour.
  "secrets": { "required": ["GOOGLE_CLOUD_PROJECT", "GOOGLE_ACCESS_TOKEN"] },
  "vars": {
    "STT_MODEL": "gemini-3.5-transcribe-live-preview",
    "AGENT_MODEL": "gemini-3.8-flash"
  },
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ConversationAgent",
        "name": "ConversationAgent"
      }
    ]
  },
  "main": "src/server.ts",
  "migrations": [
    {
      "new_sqlite_classes": ["ConversationAgent"],
      "tag": "v1"
    }
  ]
}
