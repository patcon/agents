# A Google Cloud project with Vertex AI enabled, and an OAuth token for it.
# `pnpm google-token` fills in the token. It lasts about an hour.
GOOGLE_CLOUD_PROJECT=
GOOGLE_ACCESS_TOKEN=

# Optional. When set, the app asks for this password (any username) before
# letting anyone in. Leave it empty to keep local dev open.
BASIC_AUTH_PASSWORD=
